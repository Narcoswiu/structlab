# Копирай този файл като .env.local и попълни стойностите.
# .env.local НЕ се качва в Git. Ключове никога не се пращат в чата.

# Адрес на сайта (локално остава така; във Vercel се задава домейнът)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) – може да се вижда в браузъра
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) – САМО на сървъра
SUPABASE_SECRET_KEY=

# Поща (по избор). Без тези редове поканите работят с „Копирай линка“.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="StructLab <адрес@example.com>"

# Тайна за нощната задача (Vercel Cron я праща като „Authorization: Bearer …“)
# CRON_SECRET=
