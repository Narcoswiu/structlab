{
  "name": "structlab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "check": "node scripts/check.mts",
    "check:fast": "node scripts/check.mts --fast",
    "smoke:live": "node scripts/smoke-live.mts",
    "test:rls": "vitest run --config vitest.rls.config.mts",
    "db:start": "supabase start -x realtime,storage-api,imgproxy,edge-runtime,logflare,vector,studio,postgres-meta,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "admin:create": "node --env-file=.env.local scripts/create-admin.mjs",
    "content:verify": "node scripts/content.mts verify",
    "content:push:local": "node scripts/content.mts push --local",
    "content:push": "node --env-file=.env.local scripts/content.mts push",
    "outlines:verify": "node scripts/outlines.mts verify",
    "outlines:build": "node scripts/outlines.mts build",
    "catalog:verify": "node scripts/catalog.mts verify",
    "catalog:push:local": "node scripts/catalog.mts push --local",
    "catalog:push": "node --env-file=.env.local scripts/catalog.mts push"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "framer-motion": "^14.0.0",
    "katex": "0.19.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.9.1"
}
